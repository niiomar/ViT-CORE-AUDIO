# Copy to .env and edit before running the backend:
#   cp .env.example .env

# Shared secret for the X-API-KEY header. If unset, the API is
# unauthenticated — fine for local dev, not for any exposed deployment.
# Must match VITE_API_KEY in frontend/.env.
API_KEY=changeme

# Comma-separated additional allowed frontend origins, appended to the
# built-in localhost:5173/8000 defaults in main.py.
CORS_ORIGINS=

# Path to the trained checkpoint, relative to backend/.
MODEL_WEIGHTS_PATH=weights/vitcore_audio_best.pth

# Optional: expected SHA-256 of the checkpoint file. If set, the backend
# refuses to start when the checksum doesn't match (guards against a
# corrupted download or a swapped/tampered weights file). The actual hash
# of your checkpoint is logged at startup — capture it once from a known-good
# load and pin it here.
MODEL_WEIGHTS_SHA256=

# If the checkpoint can't be loaded with PyTorch's safe (weights_only=True)
# loader, the backend refuses to start rather than silently falling back to
# full pickle deserialization. Set to true only if you trust this specific
# checkpoint's origin and need the fallback.
ALLOW_UNTRUSTED_CHECKPOINT=false

# Path to the SQLite forensic audit log.
AUDIT_DB_PATH=audit_log.db

# Sliding-window rate limiting on the analyze endpoints. Max requests per
# window per client (by API key, or IP if unauthenticated). Set
# RATE_LIMIT_REQUESTS=0 to disable.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Max files from a single /api/v1/analyze/batch request processed
# concurrently.
BATCH_CONCURRENCY=4

# "text" (human-readable console logs, the default) or "json" (structured
# logs with a request_id field, for a log aggregator in production).
LOG_FORMAT=text
