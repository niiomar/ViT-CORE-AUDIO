# Copy to .env and edit before building:
#   cp .env.example .env
#
# Baked into the JS bundle at build time (not read at runtime) — changes
# here only take effect after `npm run build`. Must match API_KEY in
# backend/.env. This is not a real secret: it's visible to anyone who
# inspects the shipped bundle. See README's Security & Deployment Notes.
VITE_API_KEY=changeme
